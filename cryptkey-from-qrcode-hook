#!/bin/sh -e
# location path:  /usr/share/initramfs-tools/hooks

PREREQS=""

prereqs() { echo "$PREREQS"; }

case "$1" in
    prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

# modules on lines below - just for debug only
#copy_exec /usr/bin/strace
copy_exec /usr/bin/tcpdump
# lines above for debug only, will be removed or disabled

copy_exec /usr/bin/ping
copy_exec /usr/bin/nc
copy_exec /usr/bin/bc
copy_exec /usr/bin/sha256sum
copy_exec /usr/bin/keyctl
copy_exec /usr/bin/base64
copy_exec /usr/bin/oathtool
#copy_exec /usr/sbin/lvscan
#copy_exec /usr/sbin/lvdisplay
#copy_exec /usr/sbin/vgchange
copy_exec /usr/sbin/iw
copy_exec /usr/sbin/hostapd
copy_exec /usr/sbin/dnsmasq
copy_exec /lib/firmware/iwlwifi-7265D-29.ucode.zst


copy_exec /usr/bin/gphoto2
copy_exec /usr/bin/zbarcam
copy_exec /usr/bin/qrencode
for lib in /usr/lib/x86_64-linux-gnu/libgphoto2_port/*/ptpip.so \
           /usr/lib/x86_64-linux-gnu/libgphoto2_port/*/usb1.so \
           /usr/lib/x86_64-linux-gnu/libgphoto2/*/ptp2.so; do
    [ -e "$lib" ] && copy_exec "$lib"
done
copy_exec /usr/bin/age
copy_exec /usr/bin/age-keygen
copy_exec /etc/hostname
copy_exec /usr/local/sbin/cryptkey-from-qrcode

exit 0
